# Local stdio (never commit real values)
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_TIMEZONE=UTC
ICLOUD_READ_ONLY=false
ICLOUD_ALLOW_DELETE=false
ICLOUD_ALLOW_EXPUNGE=false

# Hosted HTTP
ICLOUD_MCP_ENCRYPTION_KEY=
ICLOUD_MCP_USERS_FILE=./data/users.json
ICLOUD_MCP_BIND=127.0.0.1
ICLOUD_MCP_PORT=8788
ICLOUD_MCP_RATE_LIMIT=60
ICLOUD_MCP_RATE_WINDOW_MS=60000
ICLOUD_MCP_MAX_BODY_BYTES=1048576

# Optional Redis (Vercel / shared CLI)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

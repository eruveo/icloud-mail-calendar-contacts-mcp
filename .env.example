# Full iCloud address (also accepted as ICLOUD_USERNAME)
ICLOUD_EMAIL=you@icloud.com

# App-specific password from https://account.apple.com — never a regular Apple ID password
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated: mail, calendar, contacts (default: all three)
# ICLOUD_SERVICES=mail,calendar,contacts

# Master write switch. true disables every write tool.
# ICLOUD_READ_ONLY=false

# Capability toggles (ignored when ICLOUD_READ_ONLY=true)
# ICLOUD_ALLOW_SEND=true
# ICLOUD_ALLOW_MAIL_WRITE=true
# ICLOUD_ALLOW_CALENDAR_WRITE=true
# ICLOUD_ALLOW_CONTACTS_WRITE=true
# ICLOUD_ALLOW_DELETE=false
# ICLOUD_ALLOW_EXPUNGE=false

# Optional
# ICLOUD_TIMEZONE=Australia/Sydney
# ICLOUD_ATTACHMENT_ROOT=/safe/attachments
# IMAP_HOST=imap.mail.me.com
# IMAP_PORT=993
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# ICLOUD_CALDAV_URL=https://caldav.icloud.com
# ICLOUD_CARDDAV_URL=https://contacts.icloud.com

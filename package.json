{
  "name": "icloud-mcp",
  "version": "0.1.0",
  "description": "MCP server for iCloud Mail (IMAP/SMTP), Calendar (CalDAV), and Contacts (CardDAV), with a permission model for writes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "icloud-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "icloud",
    "imap",
    "smtp",
    "caldav",
    "carddav"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "fast-xml-parser": "^5.2.5",
    "html-to-text": "^9.0.5",
    "ical.js": "^2.2.1",
    "imapflow": "^1.0.186",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.6",
    "postal-mime": "^2.4.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.1",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
